 Operators & Conditional Statements

# Basic (1–10)

# 1. Check Positive, Negative or Zero
num = int(input("Enter a number: "))

if num > 0:
    print("Positive Number")
elif num < 0:
    print("Negative Number")
else:
    print("Zero")


